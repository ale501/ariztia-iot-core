# ============================================================
# .gitignore — Proyecto Ariztía / Tracking de Pollos
# ============================================================

# Entorno virtual Python (pesado, se regenera con pip install)
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Ejecutables y carpetas de Prometheus y Grafana (binarios pesados)
prometheus-*/
grafana-*/
*.exe

# Modelos y pesos de redes neuronales (van fuera de Git)
*.pt
*.onnx
*.weights

# Bases de datos locales generadas al correr
*.db
*.sqlite
*.sqlite3
data/
postgres_data/

# Variables de entorno y secretos
.env
*.local

# Configuración de editores
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Archivos de sistema operativo
Thumbs.db
desktop.ini
.DS_Store

# Dataset de capturas (excluido para no inflar el repo)
dataset_pollitos/

# Archivos temporales y logs
*.tmp
*.log
*.bak
*.swp

# Herramientas de API testing
.postman/
postman/
