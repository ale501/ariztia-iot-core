# Variables de entorno del proyecto
# Copia este archivo como .env y ajusta los valores

# -------------------------------------------------------
# Fuente de video
# -------------------------------------------------------
FUENTE_VIDEO=esp32
IP_ESP32_CAM=192.168.4.1
PUERTO_ESP32_CAM=81

# -------------------------------------------------------
# Sensores (ESP32 serial)
# -------------------------------------------------------
PUERTO_COM=COM6
BAUD_RATE=115200
INTERVALO_LECTURA=60

# -------------------------------------------------------
# Puertos de servicios
# -------------------------------------------------------
PUERTO_WEB=8000
PUERTO_TRACKING=5000
PUERTO_ARIZTIA=5001
PUERTO_PROMETHEUS=9090
PUERTO_GRAFANA=3000
